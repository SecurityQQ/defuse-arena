{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspection-arena.local/schemas/standings.schema.json",
  "title": "Standings",
  "description": "Derived leaderboard for a season. Regenerable from the round records.",
  "type": "object",
  "required": [
    "season_id",
    "generated_at",
    "scoring_version",
    "season_sha256",
    "ledger_sha256",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "season_id": { "type": "string", "pattern": "^s-[0-9]{4}-[0-9]{2}$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "scoring_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "season_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ledger_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "rating",
          "rating_att",
          "rating_def",
          "rounds",
          "wins",
          "losses",
          "voids",
          "tokens_total",
          "tokens_per_round",
          "brier",
          "patch_validity",
          "fpr",
          "attack_survival",
          "defense_win_rate",
          "net_chips",
          "provisional"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": { "type": "string" },
          "rating": { "type": "number" },
          "rating_att": { "type": "number" },
          "rating_def": { "type": "number" },
          "rounds": { "type": "integer", "minimum": 0 },
          "wins": { "type": "integer", "minimum": 0 },
          "losses": { "type": "integer", "minimum": 0 },
          "voids": { "type": "integer", "minimum": 0 },
          "tokens_total": { "type": "integer", "minimum": 0 },
          "tokens_per_round": { "type": "number", "minimum": 0 },
          "brier": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "patch_validity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "fpr": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "attack_survival": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "defense_win_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "net_chips": { "type": "integer" },
          "provisional": {
            "type": "boolean",
            "description": "True when rounds < 20; excluded from the ordered table."
          }
        }
      }
    }
  }
}
