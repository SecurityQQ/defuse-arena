{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspection-arena.local/schemas/standings.schema.json",
  "title": "Standings",
  "description": "Derived leaderboard for a season. Regenerable from the round records.",
  "type": "object",
  "required": [
    "season_id",
    "generated_at",
    "scoring_version",
    "season_sha256",
    "ledger_sha256",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "season_id": {
      "type": "string",
      "pattern": "^s-[0-9]{4}-[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scoring_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "season_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ledger_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "rating",
          "rating_att",
          "rating_def",
          "rating_clean_att",
          "rating_clean_def",
          "rounds",
          "eligible",
          "wins",
          "losses",
          "voids",
          "tokens_total",
          "tokens_per_round",
          "brier",
          "patch_validity",
          "fpr",
          "attack_survival",
          "clean_win_rate",
          "defense_win_rate",
          "net_chips",
          "cost_total",
          "cost_per_round",
          "provisional"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "type": "string"
          },
          "model_name": {
            "type": "string",
            "description": "Resolved display name recorded by the CLI in the ATIF export (agent.model_name), e.g. deepseek-v4-pro -> DeepSeek V4 Pro High. Empty when the agent has no usable export."
          },
          "rating": {
            "type": "number"
          },
          "rating_att": {
            "type": "number"
          },
          "rating_def": {
            "type": "number"
          },
          "rating_clean_att": {
            "type": "number",
            "description": "θ=0 clean-build pool: how well the agent builds a service that does not look vulnerable."
          },
          "rating_clean_def": {
            "type": "number",
            "description": "θ=0 false-alarm pool: how well the agent avoids claiming a bug on a clean service."
          },
          "rounds": {
            "type": "integer",
            "minimum": 0
          },
          "eligible": {
            "type": "integer",
            "minimum": 0,
            "description": "Rounds the agent was available for: played rounds plus rounds an opponent forfeited. Drives the ranking threshold; an agent's own forfeits do not count."
          },
          "wins": {
            "type": "integer",
            "minimum": 0
          },
          "losses": {
            "type": "integer",
            "minimum": 0
          },
          "voids": {
            "type": "integer",
            "minimum": 0
          },
          "abstentions": {
            "type": "integer",
            "minimum": 0
          },
          "abstain_att": {
            "type": "integer",
            "minimum": 0
          },
          "abstain_def": {
            "type": "integer",
            "minimum": 0
          },
          "refusal_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "forfeits": {
            "type": "integer",
            "minimum": 0
          },
          "forfeit_att": {
            "type": "integer",
            "minimum": 0
          },
          "forfeit_def": {
            "type": "integer",
            "minimum": 0
          },
          "forfeit_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "tokens_total": {
            "type": "integer",
            "minimum": 0
          },
          "tokens_per_round": {
            "type": "number",
            "minimum": 0
          },
          "brier": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "patch_validity": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "fpr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "attack_survival": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "FN / (TP + FN) over θ=1 attack rounds: how often a planted bug survived the defender's patch."
          },
          "clean_win_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "FP / (FP + TN) over θ=0 attack rounds: how often a clean build triggered a false alarm."
          },
          "defense_win_rate": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "net_chips": {
            "type": "number",
            "description": "Chip balance in USD."
          },
          "cost_total": {
            "type": "number",
            "minimum": 0
          },
          "cost_per_round": {
            "type": "number",
            "minimum": 0
          },
          "provisional": {
            "type": "boolean",
            "description": "True when eligible < 20; excluded from the ordered table. Own forfeits lower eligibility, opponent forfeits do not."
          },
          "hist": {
            "type": "array",
            "description": "rating trail: [round_id, ts, gen, att, def] per round"
          },
          "rounds_list": {
            "type": "array",
            "description": "per-round record: [round_id, match_id, role, opponent, theta, outcome, cost_usd, rating_delta]"
          },
          "h2h": {
            "type": "array",
            "description": "head-to-head vs one opponent: [agent, games, wins, losses, cost_for, cost_against]"
          },
          "att": {
            "type": "object",
            "properties": {
              "rounds": {
                "type": "integer"
              },
              "exploit_rounds": {
                "type": "integer",
                "description": "θ=1 attack rounds played."
              },
              "clean_rounds": {
                "type": "integer",
                "description": "θ=0 clean-build rounds played."
              },
              "tokens": {
                "type": "integer"
              },
              "cost": {
                "type": "number"
              }
            }
          },
          "def": {
            "type": "object",
            "properties": {
              "rounds": {
                "type": "integer"
              },
              "patch_rounds": {
                "type": "integer",
                "description": "θ=1 defence rounds played."
              },
              "clean_rounds": {
                "type": "integer",
                "description": "θ=0 clean-service rounds played."
              },
              "tokens": {
                "type": "integer"
              },
              "cost": {
                "type": "number"
              },
              "tp": {
                "type": "integer"
              },
              "fn": {
                "type": "integer"
              },
              "fp": {
                "type": "integer"
              },
              "tn": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
