{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inspection-arena.local/schemas/match.schema.json",
  "title": "MatchRecord",
  "description": "Sealed summary of a match. Written by the GM at match end.",
  "type": "object",
  "required": [
    "match_id",
    "season_id",
    "participants",
    "rounds_planned",
    "rounds_played",
    "rounds_void",
    "tokens",
    "chips",
    "rating_delta",
    "scoring_version",
    "log_sha256",
    "started_at",
    "ended_at"
  ],
  "additionalProperties": false,
  "properties": {
    "match_id": { "type": "string", "pattern": "^m-[0-9]{4,}$" },
    "season_id": { "type": "string", "pattern": "^s-[0-9]{4}-[0-9]{2}$" },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "string" }
    },
    "rounds_planned": { "type": "integer", "minimum": 1 },
    "rounds_played": { "type": "integer", "minimum": 0 },
    "rounds_void": { "type": "integer", "minimum": 0 },
    "tokens": {
      "type": "object",
      "description": "Total tokens per agent, including void rounds.",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "chips": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "rating_delta": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "scoring_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "log_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" }
  }
}
