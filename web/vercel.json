{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/llms.txt",
      "destination": "/llm.txt"
    }
  ],
  "headers": [
    {
      "source": "/llm.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/charts/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, indexifembedded"
        }
      ]
    },
    {
      "source": "/social/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/leaderboard",
      "destination": "/board",
      "permanent": false
    },
    {
      "source": "/article",
      "destination": "/",
      "permanent": false
    }
  ]
}
